# AI Provider: "gemini" (default, free) or "anthropic"
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=your-api-key

# Email (Gmail with App Password)
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_TO=recipient@example.com

# Optional overrides
# AI_MODEL=gemini-2.5-flash
# SCAN_UNIVERSE=full_market
# MAX_DEEP_ANALYSIS=5
# TZ=America/New_York

# Yahoo Finance history cache TTL in seconds (0 disables caching)
# DATA_CACHE_TTL_SECONDS=900

# Briefing scan settings and MCP server logging
# History period (valid yfinance period)
# SCAN_PERIOD=3mo
# Holding period in days (1–90)
# SCAN_HOLDING_PERIOD=14
# Minimum absolute score (>= 0)
# SCAN_MIN_SCORE=2.0
# Minimum ADX (>= 0)
# SCAN_MIN_ADX=20
# Maximum HV proxy percentile (0–100)
# SCAN_MAX_IV_PERCENTILE=70
# Minimum average daily volume (>= 0)
# SCAN_MIN_AVG_DAILY_VOLUME=500000
# Results per direction (1–100)
# SCAN_MAX_RESULTS=15
# MCP server stderr logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
