{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "timezone": "America/Los_Angeles",
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "pdemirdjian"
  ],
  "reviewers": [
    "pdemirdjian"
  ],
  "rangeStrategy": "replace",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Group and automerge non-major dev dependencies",
      "matchDepTypes": [
        "dev"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dev dependencies",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group pytest packages",
      "groupName": "pytest",
      "matchPackageNames": [
        "/^pytest/"
      ]
    },
    {
      "description": "Group typing/linting tools",
      "matchPackageNames": [
        "ruff",
        "mypy"
      ],
      "groupName": "linting tools"
    },
    {
      "description": "Use fix commit type for production deps to trigger releases",
      "matchDepTypes": [
        "project.dependencies"
      ],
      "semanticCommitType": "fix"
    },
    {
      "description": "Automerge non-major production dependencies with 3-day soak",
      "matchDepTypes": [
        "project.dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Batch major-version bumps into the Monday review window",
      "matchUpdateTypes": [
        "major"
      ],
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Automerge non-major Docker base image updates with 3-day soak; use fix commit type to trigger releases",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "semanticCommitType": "fix",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Skip digest-only Dockerfile PRs; rely on apt-get upgrade at build time and Trivy scan for OS CVEs. Version bumps (major/minor/patch) still flow through.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "Automerge GitHub Actions patches and minor updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group and automerge pre-commit hook updates",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pre-commit hooks",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track tool versions annotated with an inline renovate comment in workflow files (e.g. the Trivy binary version passed to trivy-action)",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "version: (?<currentValue>v[0-9.]+) # renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[\\w./-]+)"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  }
}
